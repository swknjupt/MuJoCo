<mujoco model="pendulum">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <worldbody>
    <light name="top_light" pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.85 0.85 0.85 1"/>

    <body name="pole" pos="0 0 1.2">
      <joint name="hinge" type="hinge" axis="0 1 0" damping="0.05"
             limited="true" range="-90 90"/>
      <geom name="rod" type="capsule" fromto="0 0 0  0 0 -0.8"
            size="0.03" mass="1" rgba="0.2 0.7 0.3 1"/>
      <site name="tip" pos="0 0 -0.8" size="0.02"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor" joint="hinge" gear="1" ctrlrange="-5 5"/>
  </actuator>

  <sensor>
    <jointpos name="angle_sensor" joint="hinge"/>
    <jointvel name="angvel_sensor" joint="hinge"/>
    <framepos name="tip_pos" objtype="site" objname="tip"/>
  </sensor>
</mujoco>
