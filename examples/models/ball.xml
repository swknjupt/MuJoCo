<mujoco model="ball_scene">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="640" offheight="480"/>
  </visual>

  <worldbody>
    <light name="top_light" pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.85 0.85 0.85 1"/>

    <body name="red_ball" pos="0 0 1.5">
      <freejoint name="ball_joint"/>
      <geom name="red_sphere" type="sphere" size="0.1" mass="1" rgba="0.9 0.2 0.2 1"/>
    </body>

    <body name="blue_box" pos="0.5 0 0.15" euler="0 0 0.3">
      <joint name="box_joint" type="free"/>
      <geom name="blue_cube" type="box" size="0.1 0.1 0.1" mass="0.5" rgba="0.2 0.3 0.9 1"/>
    </body>
  </worldbody>
</mujoco>
